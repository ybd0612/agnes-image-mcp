{
  "name": "agnes-image-mcp",
  "version": "0.1.0",
  "description": "MCP stdio server for Agnes image generation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agnes-image-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "pack-check": "node scripts/check-pack.mjs",
    "smoke": "node scripts/smoke-stdio.mjs",
    "smoke:tarball": "node scripts/smoke-tarball.mjs",
    "verify-release": "node scripts/verify-release.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run verify-release && npm run pack-check && npm run smoke && npm run smoke:tarball"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "8.2.2",
    "vitest": "4.0.8"
  }
}
